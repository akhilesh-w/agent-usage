{
  "name": "agent-readout",
  "productName": "Agent Readout",
  "version": "0.1.0",
  "description": "Local multi-agent usage dashboard (Claude, Codex, pi)",
  "main": "main.js",
  "author": "Agent Readout",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "app.agentreadout.desktop",
    "productName": "Agent Readout",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../agent_readout",
        "to": "agent_readout",
        "filter": ["**/*"]
      },
      {
        "from": "../../web/static",
        "to": "web/static",
        "filter": ["**/*"]
      },
      {
        "from": "../../data",
        "to": "data",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "identity": null
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
